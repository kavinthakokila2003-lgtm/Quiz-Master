{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-master",
  "main": "worker.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quizmaster",
      "database_id": "32dffd89-f215-4fb0-ad25-25eac9c7f9af"
    }
  ]
}
